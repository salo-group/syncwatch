{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.syncwatch.invalid/v2/room-call-request.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 2,
          "type": "integer"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "v",
        "requestId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 2,
          "type": "integer"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "callId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "v",
        "requestId",
        "callId",
        "generation"
      ],
      "additionalProperties": false
    }
  ]
}
