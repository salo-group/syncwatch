{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.syncwatch.invalid/v1/call-capabilities.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "type": "integer"
    },
    "canObserveJoin": {
      "type": "boolean"
    },
    "canMuteFromNativeUI": {
      "type": "boolean"
    },
    "canSelectDevicesFromNativeUI": {
      "type": "boolean"
    },
    "canSetCallVolume": {
      "type": "boolean"
    },
    "canObserveRemoteSpeaking": {
      "type": "boolean"
    },
    "canConfirmHangup": {
      "type": "boolean"
    }
  },
  "required": [
