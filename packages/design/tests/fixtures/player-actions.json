    {
      "name": "requests do not mutate observations",
      "state": "paused",
      "positionMs": 1000,
      "durationMs": 20000,
      "volume": 0.7,
      "skipSeconds": 10,
      "hasPrevious": true,
      "hasNext": true,
      "enabledActions": [
        "playPause",
        "seek",
        "skip",
        "previousFile",
        "nextFile",
        "setMovieVolume",
        "muteMovie",
        "showLibrary",
        "endWatching",
        "openCall",
        "toggleFullscreen"
      ],
      "requests": [
        {
          "action": "seek",
          "value": 5000
        },
        {
          "action": "skip",
          "value": 1
        },
        {
          "action": "skip",
          "value": -1
        },
        {
          "action": "playPause"
        }
      ],
      "expected": [
        {
          "action": "seek",
          "value": 5000
        },
        {
          "action": "seek",
          "value": 11000
        },
        {
          "action": "seek",
          "value": 0
        },
        {
          "action": "playPause"
        }
      ]
    },
